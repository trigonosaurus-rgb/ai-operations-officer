  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Ask the agent (Server-Sent Events stream)",
        "description": "Streams `tool_call`, `tool_result`, `token`, then `done` (or `error`) events.\n\nEach SSE message's `data` is one JSON `AgentEvent`; dispatch on its `type` field.\nThe return annotation puts the event schemas into OpenAPI (\u2192 TypeScript types).",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/ToolCallEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ToolResultEvent"
                          },
                          {
                            "$ref": "#/components/schemas/TokenEvent"
                          },
                          {
                            "$ref": "#/components/schemas/DoneEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ErrorEvent"
                          }
                        ],
                        "discriminator": {
                          "propertyName": "type",
                          "mapping": {
                            "tool_call": "#/components/schemas/ToolCallEvent",
                            "tool_result": "#/components/schemas/ToolResultEvent",
                            "token": "#/components/schemas/TokenEvent",
                            "done": "#/components/schemas/DoneEvent",
                            "error": "#/components/schemas/ErrorEvent"
                          }
                        },
                        "title": "Streamitem Chat Api Chat Post"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
